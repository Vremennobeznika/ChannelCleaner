{
  "manifest_version": 3,
  "name": "ChannelCleaner — контроль подписчиков",
  "description": "Локальные отметки кандидатов, повторная проверка через 30 суток и ограниченная очистка через Bot API после подтверждений.",
  "version": "0.6.0",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "scanner.js",
        "profiles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChannelCleaner: откройте вкладку Telegram Web"
  },
  "host_permissions": [
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
